<!DOCTYPE html>
<html lang="th">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= it.title %></title>
    <script src="https://unpkg.com/htmx.org@2.0.10"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.typekit.net/pqh4fhl.css">
    <link rel="stylesheet" href="/main.css">
  </head>

  <body class="bg-[#f8fafc] text-slate-800 min-h-screen py-6 px-4 sm:px-6">
    <div class="mx-auto max-w-7xl flex flex-col gap-6">

      <!-- Top Header Navbar -->
      <header class="flex flex-col sm:flex-row sm:items-center justify-between bg-white border border-slate-200/80 rounded-2xl px-5 py-4 shadow-xs gap-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-[#d53583] to-[#9c1356] flex items-center justify-center text-white shadow-md shadow-pink-500/20 shrink-0">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <div>
            <h1 class="tk-malila text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
              <span>Parnuan Memory Engine</span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-pink-50 text-[#d53583] border border-pink-200 font-sans tracking-normal">Assignment 2</span>
            </h1>
            <p class="text-xs text-slate-500 font-normal">
              ระบบจดจำพฤติกรรมและจัดหมวดหมู่รายจ่ายอัตโนมัติตามประวัติของผู้ใช้
            </p>
          </div>
        </div>

        <!-- Quick Switcher Dropdown in Header -->
        <div class="flex items-center gap-3">
          <label for="header-user-select" class="text-xs text-slate-400 font-medium">สลับผู้ใช้:</label>
          <div class="relative flex items-center bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 hover:border-pink-300 transition-all">
            <select id="header-user-select" onchange="window.location.href = '/?userId=' + this.value" class="appearance-none bg-transparent pr-6 text-xs font-bold text-slate-800 focus:outline-none cursor-pointer">
              <% it.users.forEach((u) => { %>
                <option value="<%= u.id %>" <%= (u.id === it.currentUser.id) ? 'selected' : '' %>>
                  <%= u.name %> (<%= u.id %>)
                </option>
              <% }) %>
            </select>
            <svg class="w-3.5 h-3.5 text-slate-400 pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </header>

      <!-- Main 2-Column Grid Layout: Sidebar (Left) + Content (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- ================= SIDEBAR COLUMN (Left: 4 Cols) ================= -->
        <aside class="lg:col-span-4 flex flex-col gap-5 sticky top-6">

          <!-- User Profile & Memory Settings Card -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col gap-4">
            <!-- Active User Display -->
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
              <div class="flex items-center gap-3">
                <div class="relative shrink-0">
                  <img src="<%= it.currentUser.avatar %>" alt="<%= it.currentUser.name %>" class="w-12 h-12 rounded-full object-cover ring-2 ring-pink-500/20 border border-white shadow-xs" />
                  <span id="user-avatar-dot" class="absolute bottom-0 right-0 w-3.5 h-3.5 rounded-full border-2 border-white <%= it.memoryEnabled ? 'bg-emerald-500' : 'bg-slate-400' %> transition-all"></span>
                </div>
                <div class="flex flex-col">
                  <span class="text-sm font-bold text-slate-900"><%= it.currentUser.name %></span>
                  <span class="text-xs text-slate-400 font-mono"><%= it.currentUser.id %></span>
                </div>
              </div>
            </div>

            <!-- Memory Mode Toggle Switch -->
            <div class="bg-slate-50 border border-slate-100 rounded-xl p-3.5 flex flex-col gap-2.5">
              <div class="flex items-center justify-between">
                <div class="flex flex-col">
                  <span class="text-xs font-bold text-slate-800">โหมดจัดหมวดด้วยความจำ</span>
                  <span class="text-[11px] text-slate-500">แนะนำหมวดจากประวัติ</span>
                </div>

                <!-- HTMX Toggle Form -->
                <form hx-post="/ui/settings/memory" hx-target="#toggle-status" hx-swap="innerHTML" class="flex items-center">
                  <input type="hidden" name="userId" value="<%= it.currentUser.id %>">
                  <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="enabled" value="true" onchange="this.form.requestSubmit()" <%= it.memoryEnabled ? 'checked' : '' %> class="sr-only peer">
                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#d53583]"></div>
                  </label>
                </form>
              </div>

              <!-- Toggle Status Badge -->
              <div id="toggle-status" class="flex justify-end">
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full border <%= it.memoryEnabled ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200' %> transition-all">
                  <%= it.memoryEnabled ? 'เปิดใช้งานความจำแล้ว' : 'ปิดใช้งานความจำแล้ว' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Inspectable Memory Insights Sidebar Card -->
          <div id="memory-insights-card" class="bg-white rounded-2xl p-5 border border-slate-200 shadow-xs flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div class="flex items-center gap-2">
                <h2 class="text-sm font-bold text-slate-900">สิ่งที่ระบบจำได้ (Memory Insights)</h2>
              </div>
              <div class="flex items-center gap-2">
                <% if (it.memories.length > 0) { %>
                  <button
                    hx-post="/ui/memory/clear"
                    hx-vals='{"userId": "<%= it.currentUser.id %>"}'
                    hx-target="#memory-insights-card"
                    hx-swap="outerHTML"
                    hx-confirm="ต้องการล้างความจำทั้งหมดของ <%= it.currentUser.name %> ใช่หรือไม่?"
                    class="text-[11px] text-red-500 hover:text-red-700 hover:underline font-medium cursor-pointer"
                  >
                    ล้างทั้งหมด
                  </button>
                <% } %>
                <span class="text-[11px] bg-pink-50 text-[#d53583] font-bold px-2.5 py-0.5 rounded-full border border-pink-200">
                  <%= it.memories.length %> คำ
                </span>
              </div>
            </div>

            <p class="text-xs text-slate-500 -mt-1">
              คำศัพท์ที่เรียนรู้จากประวัติของ <strong class="text-slate-700"><%= it.currentUser.name %></strong>
            </p>

            <% if (it.memories.length === 0) { %>
              <div class="bg-slate-50 border border-dashed border-slate-200 rounded-xl p-5 text-center text-slate-500 text-xs">
                ยังไม่มีความจำที่บันทึกไว้สำหรับผู้ใช้นี้ (ทดลองพิมพ์และกดยืนยันบันทึกทางขวาเพื่อสอนระบบ)
              </div>
            <% } else { %>
              <div class="flex flex-col gap-2 max-h-[380px] overflow-y-auto pr-1">
                <% it.memories.forEach((mem) => { %>
                  <div class="p-3 bg-slate-50/80 border border-slate-200 rounded-xl flex flex-col gap-1.5 hover:border-pink-300 hover:bg-white transition-all shadow-2xs">
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-xs font-bold text-slate-800 break-words"><%= mem.keyword %></span>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <span class="text-[11px] bg-pink-50 text-[#d53583] border border-pink-200 px-2 py-0.5 rounded font-semibold">
                          <%= mem.preferredCategoryTitle %>
                        </span>
                        <button
                          hx-post="/ui/memory/delete"
                          hx-vals='{"userId": "<%= it.currentUser.id %>", "keyword": "<%= mem.keyword %>"}'
                          hx-target="#memory-insights-card"
                          hx-swap="outerHTML"
                          hx-confirm="ต้องการลบความจำ '<%= mem.keyword %>' ใช่หรือไม่?"
                          class="text-slate-400 hover:text-red-500 hover:bg-red-50 p-1 rounded-lg transition-all cursor-pointer"
                          title="ลบความจำคำนี้"
                        >
                          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1.5 border-t border-slate-200/50">
                      <span>ใช้ไป: <strong class="text-slate-700"><%= mem.frequency %> ครั้ง</strong></span>
                      <span class="text-emerald-600 font-semibold">มั่นใจ <%= Math.round(mem.confidence * 100) %>%</span>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </aside>

        <!-- ================= MAIN WORKSPACE (Right: 8 Cols) ================= -->
        <main class="lg:col-span-8 flex flex-col gap-6">

          <!-- Input Expense Form Card -->
          <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs">
            <form hx-post="/ui/parse" hx-target="#review" hx-swap="innerHTML" class="flex flex-col gap-4">
              <input type="hidden" name="userId" value="<%= it.currentUser.id %>">

              <!-- Textarea Container -->
              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <label for="expense-input" class="text-sm font-semibold text-slate-700 flex items-center gap-1.5">
                    <span>จดบันทึกรายจ่ายสำหรับ</span>
                    <span class="text-[#d53583] font-bold">[<%= it.currentUser.name %>]</span>
                  </label>
                  <span class="text-xs text-slate-400">รองรับหลายรายการ & วันที่</span>
                </div>

                <textarea id="expense-input" required name="text" rows="3" class="w-full p-3.5 text-base text-slate-800 bg-slate-50/70 border border-slate-200 rounded-xl focus:bg-white focus:border-[#d53583] focus:ring-4 focus:ring-pink-500/15 transition-all outline-none resize-y placeholder:text-slate-400" placeholder="พิมพ์ข้อความ เช่น 'ข้าวมันไก่ 50' หรือ 'เมื่อวานตอน 5 โมงครึ่ง bts 45'"></textarea>
              </div>

              <!-- Quick Example Chips -->
              <div class="flex flex-wrap items-center gap-2 pt-1 border-t border-slate-100">
                <span class="text-xs text-slate-400 font-medium">ตัวอย่างทดสอบ:</span>
                <button type="button" onclick="document.getElementById('expense-input').value = 'ข้าวมันไก่ 50'; document.getElementById('expense-input').focus();" class="text-xs bg-slate-50 hover:bg-pink-50 hover:text-[#d53583] hover:border-pink-200 border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium">
                  ข้าวมันไก่ 50
                </button>
                <button type="button" onclick="document.getElementById('expense-input').value = 'ข้าวมันไก่ 50 น้ำเปล่า 7 แล้วก็ช้อปปิ้ง 500'; document.getElementById('expense-input').focus();" class="text-xs bg-slate-50 hover:bg-pink-50 hover:text-[#d53583] hover:border-pink-200 border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium">
                  หลายรายการพร้อมกัน
                </button>
                <button type="button" onclick="document.getElementById('expense-input').value = 'เมื่อวานตอน 5 โมงครึ่ง bts หมอชิต 45'; document.getElementById('expense-input').focus();" class="text-xs bg-slate-50 hover:bg-pink-50 hover:text-[#d53583] hover:border-pink-200 border border-slate-200 text-slate-600 px-3 py-1.5 rounded-lg transition-all cursor-pointer font-medium">
                  เมื่อวานตอน 5 โมงครึ่ง bts หมอชิต 45
                </button>
              </div>

              <!-- Submit Button -->
              <div class="flex flex-row items-center justify-end pt-3">
                <button class="flex items-center justify-center bg-gradient-to-t from-[#b51f68] via-[#d53583] to-[#f05aa0] text-white font-semibold py-2.5 px-7 rounded-xl min-w-[140px] relative cursor-pointer shadow-lg shadow-[#d53583]/30 hover:brightness-105 active:scale-95 transition-all duration-200 text-base" type="submit">
                  <img src="https://parnuan.com/_next/image?url=%2Fimages%2Fmascot%2Fparnuan-hang.png&w=96&q=75" class="absolute -top-9 left-2 w-16 h-10 pointer-events-none" alt="Parnuan Mascot" />
                  <span>จดเลย!</span>
                </button>
              </div>
            </form>
          </div>

          <!-- Review Section (Rendered via HTMX) -->
          <section id="review" class="w-full transition-all duration-300"></section>

          <!-- Transaction History & Memory Edit Sync Section (Demo Flow 2) -->
          <section class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs flex flex-col gap-4">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
              <div>
                <h2 class="text-base font-bold text-slate-900">
                  ประวัติรายการล่าสุด (History & Real-time Edit)
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                  ทดสอบ Demo Flow 2: เมื่อแก้ไขหมวดหมู่ของรายการในอดีต ความจำของระบบจะเปลี่ยนตามทันที
                </p>
              </div>
            </div>

            <% if (it.transactions.length === 0) { %>
              <div class="bg-slate-50 border border-dashed border-slate-200 rounded-xl p-8 text-center text-slate-500 text-sm">
                ยังไม่มีประวัติรายการสำหรับ <%= it.currentUser.name %>
              </div>
            <% } else { %>
              <div class="border border-slate-200 rounded-xl divide-y divide-slate-200 bg-white overflow-visible">
                <% it.transactions.forEach((tx, idx) => { %>
                  <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50 transition-colors relative first:rounded-t-xl last:rounded-b-xl">
                    <div class="flex items-center gap-3">
                      <span class="w-6 h-6 rounded-full bg-slate-100 text-slate-600 text-xs font-bold flex items-center justify-center shrink-0">
                        #<%= idx + 1 %>
                      </span>
                      <div class="flex flex-col">
                        <span class="text-sm font-semibold text-slate-800"><%= tx.description %></span>
                        <span class="text-xs text-slate-400 font-mono">ID: <%= tx.id %></span>
                      </div>
                    </div>

                    <div class="flex items-center gap-3 justify-between sm:justify-end">
                      <span class="text-sm font-bold text-emerald-600">
                        <%= tx.amount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> บาท
                      </span>

                      <!-- Interactive Category Edit Form for Flow 2 Demo with Custom Dropdown Component -->
                      <form hx-post="/ui/transactions/edit" hx-target="#tx-status-<%= tx.id %>" hx-swap="innerHTML" class="flex items-center gap-2">
                        <input type="hidden" name="userId" value="<%= it.currentUser.id %>">
                        <input type="hidden" name="transactionId" value="<%= tx.id %>">
                        <div class="w-48">
                          <%~ include('components/category-dropdown', { categoryTitle: tx.categoryTitle, categoryId: tx.categoryId, name: 'categoryId', autoSubmit: true }) %>
                        </div>
                        <div id="tx-status-<%= tx.id %>"></div>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </section>
        </main>
      </div>
    </div>

    <!-- Global Client Script for Custom Category Dropdown Component -->
    <script>
      function toggleCategoryMenu(btn) {
        const container = btn.closest('.custom-category-dropdown');
        const popover = container.querySelector('.category-menu-popover');
        const isOpening = popover.classList.contains('hidden');

        document.querySelectorAll('.category-menu-popover').forEach(p => {
          p.classList.add('hidden');
          p.closest('.custom-category-dropdown')?.classList.remove('z-50');
        });

        if (isOpening) {
          popover.classList.remove('hidden');
          container.classList.add('z-50');
        }
      }

      function selectCategoryItem(itemBtn, catName, autoSubmit) {
        const container = itemBtn.closest('.custom-category-dropdown');
        const input = container.querySelector('.category-hidden-input');
        const label = container.querySelector('.selected-category-label');
        const popover = container.querySelector('.category-menu-popover');

        input.value = catName;
        label.innerHTML = itemBtn.querySelector('span').innerHTML;
        popover.classList.add('hidden');
        container.classList.remove('z-50');

        if (autoSubmit) {
          const form = container.closest('form');
          if (form) form.requestSubmit();
        }
      }

      function showCustomCategoryInput(btn) {
        const area = btn.closest('.custom-category-action-area');
        const triggerBtn = area.querySelector('.custom-category-trigger-btn');
        const inputBox = area.querySelector('.custom-category-input-box');
        const textInput = area.querySelector('.custom-category-text');

        triggerBtn.classList.add('hidden');
        inputBox.classList.remove('hidden');
        textInput.focus();
      }

      function applyCustomCategoryInline(btnOrInput, autoSubmit) {
        const container = btnOrInput.closest('.custom-category-dropdown');
        const area = container.querySelector('.custom-category-action-area');
        const textInput = area.querySelector('.custom-category-text');
        const customVal = (textInput.value || '').trim();

        if (customVal) {
          const input = container.querySelector('.category-hidden-input');
          const label = container.querySelector('.selected-category-label');
          const popover = container.querySelector('.category-menu-popover');

          input.value = customVal;
          label.innerHTML = '✨ ' + customVal;
          popover.classList.add('hidden');
          container.classList.remove('z-50');

          textInput.value = '';
          area.querySelector('.custom-category-trigger-btn').classList.remove('hidden');
          area.querySelector('.custom-category-input-box').classList.add('hidden');

          if (autoSubmit) {
            const form = container.closest('form');
            if (form) form.requestSubmit();
          }
        }
      }

      document.addEventListener('click', function(e) {
        if (!e.target.closest('.custom-category-dropdown')) {
          document.querySelectorAll('.category-menu-popover').forEach(p => {
            p.classList.add('hidden');
            p.closest('.custom-category-dropdown')?.classList.remove('z-50');
          });
        }
      });
    </script>
  </body>

</html>