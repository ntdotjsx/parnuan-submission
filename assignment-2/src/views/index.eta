<!DOCTYPE html>
<html lang="th">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= it.title %></title>
    <script src="https://unpkg.com/htmx.org@2.0.10"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.typekit.net/pqh4fhl.css">
    <link rel="stylesheet" href="/main.css">
  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen py-8 px-4 sm:px-6">
    <div class="flex flex-col gap-6 mx-auto max-w-5xl">
      <!-- Header Section -->
      <header class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 pb-4 gap-4">
        <div>
          <div class="flex items-center gap-2">
            <h1 class="tk-malila text-3xl sm:text-4xl font-bold text-[#d53583] tracking-tight">
              Parnuan Memory Engine
            </h1>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 font-light">
            ระบบจดจำพฤติกรรมและจัดหมวดหมู่รายจ่ายอัตโนมัติตามประวัติของผู้ใช้ (Assignment 2)
          </p>
        </div>

        <!-- User Switcher Dropdown & Memory Status Badge -->
        <div class="flex items-center gap-3 bg-white border border-slate-200 rounded-2xl p-2.5 shadow-xs">
          <img src="<%= it.currentUser.avatar %>" alt="User Avatar" class="w-10 h-10 rounded-full border border-pink-200 object-cover shrink-0" />
          <div class="flex flex-col gap-0.5">
            <div class="flex items-center gap-2">
              <label for="user-select" class="text-xs text-slate-400 font-medium">ผู้ใช้งาน:</label>
              <select id="user-select" onchange="window.location.href = '/?userId=' + this.value" class="text-sm font-bold text-slate-800 bg-transparent border-b border-pink-300 focus:outline-none cursor-pointer">
                <% it.users.forEach((u) => { %>
                  <option value="<%= u.id %>" <%= (u.id === it.currentUser.id) ? 'selected' : '' %>>
                    <%= u.name %> (<%= u.id %>)
                  </option>
                <% }) %>
              </select>
            </div>
            <span class="text-xs text-slate-500">
              สถานะความจำ: <%= it.memoryEnabled ? 'เปิดใช้งาน' : 'ปิดใช้งาน' %>
            </span>
          </div>
        </div>
      </header>

      <!-- User Memory Controls Card -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-pink-50 text-[#d53583] font-bold text-sm flex items-center justify-center border border-pink-200">
            [M]
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-800">โหมดจัดหมวดด้วยความจำ (Memory Layer)</h3>
            <p class="text-xs text-slate-500">
              เมื่อเปิดใช้งาน ระบบจะนำประวัติของ <%= it.currentUser.name %> มาช่วยจัดหมวดหมู่อัตโนมัติ
            </p>
          </div>
        </div>

        <!-- Memory Toggle Form -->
        <form hx-post="/ui/settings/memory" hx-target="#toggle-status" hx-swap="innerHTML" class="flex items-center gap-3">
          <input type="hidden" name="userId" value="<%= it.currentUser.id %>">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="enabled" value="true" onchange="this.form.requestSubmit()" <%= it.memoryEnabled ? 'checked' : '' %> class="sr-only peer">
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#d53583]"></div>
          </label>
          <div id="toggle-status">
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full border <%= it.memoryEnabled ? 'bg-emerald-100 text-emerald-800 border-emerald-300' : 'bg-slate-100 text-slate-600 border-slate-300' %>">
              <%= it.memoryEnabled ? 'เปิดใช้งานความจำแล้ว' : 'ปิดใช้งานความจำแล้ว' %>
            </span>
          </div>
        </form>
      </div>

      <!-- Review Section (Rendered via HTMX) -->
      <section id="review" class="w-full transition-all duration-300"></section>

      <!-- Input Form Card -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-sm">
        <form hx-post="/ui/parse" hx-target="#review" hx-swap="innerHTML" class="flex flex-col gap-4">
          <input type="hidden" name="userId" value="<%= it.currentUser.id %>">

          <!-- Textarea Container -->
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <label for="expense-input" class="text-sm font-semibold text-slate-700">
                จดบันทึกรายจ่ายสำหรับ [<%= it.currentUser.name %>]
              </label>
              <span class="text-xs text-slate-400">รองรับหลายรายการ & วันที่</span>
            </div>

            <textarea
              id="expense-input"
              required
              name="text"
              rows="3"
              class="w-full p-3.5 text-base text-slate-800 bg-slate-50 border border-slate-300 rounded-xl focus:bg-white focus:border-[#d53583] focus:ring-4 focus:ring-pink-500/15 transition-all outline-none resize-y placeholder:text-slate-400"
              placeholder="พิมพ์ข้อความ เช่น 'ข้าวมันไก่ 50' หรือ 'เมื่อวานตอน 5 โมงครึ่ง bts 45'"></textarea>
          </div>

          <!-- Quick Example Chips -->
          <div class="flex flex-wrap items-center gap-2 pt-1 border-t border-slate-100">
            <span class="text-xs text-slate-400 font-medium">ตัวอย่างทดสอบ:</span>
            <button type="button" onclick="document.getElementById('expense-input').value = 'ข้าวมันไก่ 50'; document.getElementById('expense-input').focus();" class="text-xs bg-slate-100 hover:bg-pink-50 hover:text-[#d53583] hover:border-pink-200 border border-slate-200 text-slate-600 px-2.5 py-1 rounded-lg transition-all cursor-pointer">
              ข้าวมันไก่ 50
            </button>
            <button type="button" onclick="document.getElementById('expense-input').value = 'ข้าวมันไก่ 50 น้ำเปล่า 7 แล้วก็ช้อปปิ้ง 500'; document.getElementById('expense-input').focus();" class="text-xs bg-slate-100 hover:bg-pink-50 hover:text-[#d53583] hover:border-pink-200 border border-slate-200 text-slate-600 px-2.5 py-1 rounded-lg transition-all cursor-pointer">
              หลายรายการพร้อมกัน
            </button>
            <button type="button" onclick="document.getElementById('expense-input').value = 'เมื่อวานตอน 5 โมงครึ่ง bts หมอชิต 45'; document.getElementById('expense-input').focus();" class="text-xs bg-slate-100 hover:bg-pink-50 hover:text-[#d53583] hover:border-pink-200 border border-slate-200 text-slate-600 px-2.5 py-1 rounded-lg transition-all cursor-pointer">
              เมื่อวานตอน 5 โมงครึ่ง bts หมอชิต 45
            </button>
          </div>

          <!-- Submit Button -->
          <div class="flex flex-row items-center justify-end pt-3">
            <button class="flex items-center justify-center bg-gradient-to-t from-[#b51f68] via-[#d53583] to-[#f05aa0] text-white font-semibold py-2.5 px-7 rounded-xl min-w-[140px] cursor-pointer shadow-md hover:brightness-105 active:scale-95 transition-all duration-200 text-base" type="submit">
              <span>ตรวจสอบและจัดหมวด</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Inspectable Memory Card (สิ่งที่ระบบจำได้) -->
      <section class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-sm flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div>
            <h2 class="text-base font-bold text-slate-800">สิ่งที่ระบบจำได้ (Memory Insights)</h2>
            <p class="text-xs text-slate-500">
              วิเคราะห์จากประวัติธุรกรรมที่ยืนยันแล้วของ <%= it.currentUser.name %> ทั้งหมด <%= it.memories.length %> คำ
            </p>
          </div>
          <span class="text-xs bg-pink-100 text-[#d53583] font-bold px-3 py-1 rounded-full border border-pink-200">
            <%= it.memories.length %> คำศัพท์ที่เรียนรู้
          </span>
        </div>

        <% if (it.memories.length === 0) { %>
          <div class="bg-slate-50 border border-dashed border-slate-200 rounded-xl p-6 text-center text-slate-500 text-sm">
            ยังไม่มีประวัติความจำสำหรับ <%= it.currentUser.name %> (ทดลองพิมพ์ข้อความและกดยืนยันบันทึกเพื่อสร้างความจำ)
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <% it.memories.forEach((mem) => { %>
              <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl flex flex-col justify-between gap-2 hover:border-pink-300 transition-all">
                <div class="flex items-start justify-between gap-2">
                  <span class="text-sm font-bold text-slate-800 break-words"><%= mem.keyword %></span>
                  <span class="text-xs bg-pink-50 text-pink-700 border border-pink-200 px-2 py-0.5 rounded font-medium shrink-0">
                    <%= mem.preferredCategoryTitle %>
                  </span>
                </div>
                <div class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-200/60">
                  <span>ความถี่: <strong><%= mem.frequency %> ครั้ง</strong></span>
                  <span class="text-emerald-700 font-semibold">มั่นใจ <%= Math.round(mem.confidence * 100) %>%</span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <!-- Transaction History & Memory Edit Sync Section (Demo Flow 2) -->
      <section class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-sm flex flex-col gap-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
          <div>
            <h2 class="text-base font-bold text-slate-800">ประวัติรายการล่าสุด (History & Real-time Edit)</h2>
            <p class="text-xs text-slate-500">
              ทดสอบ Demo Flow 2: เมื่อแก้ไขหมวดหมู่ของรายการในอดีต ความจำของระบบจะเปลี่ยนตามทันที
            </p>
          </div>
        </div>

        <% if (it.transactions.length === 0) { %>
          <div class="bg-slate-50 border border-dashed border-slate-200 rounded-xl p-6 text-center text-slate-500 text-sm">
            ยังไม่มีประวัติรายการสำหรับ <%= it.currentUser.name %>
          </div>
        <% } else { %>
          <div class="border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-200 bg-white">
            <% it.transactions.forEach((tx, idx) => { %>
              <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-full bg-slate-100 text-slate-600 text-xs font-bold flex items-center justify-center shrink-0">
                    <%= idx + 1 %>
                  </span>
                  <div class="flex flex-col">
                    <span class="text-sm font-semibold text-slate-800"><%= tx.description %></span>
                    <span class="text-xs text-slate-400">ID: <%= tx.id %></span>
                  </div>
                </div>

                <div class="flex items-center gap-3 justify-between sm:justify-end">
                  <span class="text-sm font-bold text-emerald-600">
                    <%= tx.amount.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> บาท
                  </span>

                  <!-- Interactive Category Edit Form for Flow 2 Demo -->
                  <form hx-post="/ui/transactions/edit" hx-target="#tx-status-<%= tx.id %>" hx-swap="innerHTML" class="flex items-center gap-2">
                    <input type="hidden" name="userId" value="<%= it.currentUser.id %>">
                    <input type="hidden" name="transactionId" value="<%= tx.id %>">
                    <select name="categoryId" onchange="this.form.requestSubmit()" class="text-xs bg-white border border-slate-300 rounded-lg px-2 py-1 text-slate-700 focus:outline-none focus:border-[#d53583] cursor-pointer">
                      <% it.categories.forEach((cat) => { %>
                        <option value="<%= cat.id %>" <%= (cat.id === tx.categoryId) ? 'selected' : '' %>>
                          <%= cat.title %>
                        </option>
                      <% }) %>
                    </select>
                    <div id="tx-status-<%= tx.id %>"></div>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </body>

</html>